<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.diptopal.jobsearch.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/roydi/.diptopal-job-search/runtime/scripts/job-search-local-collector.mjs</string>
    <string>--headless</string>
    <string>--skip-google</string>
    <string>--extract-limit=200</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/roydi/.diptopal-job-search/runtime</string>
  <key>StartInterval</key>
  <integer>43200</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/roydi/.diptopal-job-search/logs/collector.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/roydi/.diptopal-job-search/logs/collector.error.log</string>
</dict>
</plist>
